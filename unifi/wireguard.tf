# WireGuard road-warrior server on the UDM and its peers. Addresses and DNS
# servers come from var.wireguard, the peers from var.wireguard_peers (Secret
# unifi-vars); `mise run unifi:wg-add-peer` adds a device, `unifi:wg-profile`
# builds its client config.
#
# The server key pair is generated by the provider and lives only in the
# in-cluster state (no private_key in unifi-vars).

locals {
  # gateway form of the clients' GUA /64 (also the firewall group's member):
  # the first address of the /64 plus its mask. Global addresses, so the
  # clients reach the internet over IPv6 without NAT66; inbound stays blocked
  # by the UDM's default WANv6_IN policy.
  wireguard_subnet_v6 = "${cidrhost(local.firewall_cidrs.wireguard_home_v6, 1)}/${split("/", local.firewall_cidrs.wireguard_home_v6)[1]}"
}

resource "unifi_vpn_server" "wireguard" {
  name        = "WireGuard"
  subnet      = local.wireguard.subnet
  subnet_ipv6 = local.wireguard_subnet_v6

  wireguard = {
    ip_version = "v4"
    port       = 51820
  }
  wan = {
    interface = lower(unifi_wan.ftth.networkgroup)
    ip        = "any"
  }
  # IPv4 only: the controller keeps two IPv4 servers (dhcpd_dns_1/2) and drops
  # IPv6 entries, which the provider then reports as an inconsistent result
  dns = {
    servers = local.wireguard.dns_servers
  }
}

resource "unifi_wireguard_peer" "this" {
  for_each = local.wireguard_peer_keys

  network_id     = unifi_vpn_server.wireguard.id
  name           = each.key
  interface_ip   = local.wireguard_peers[each.key].interface_ip
  interface_ipv6 = local.wireguard_peers[each.key].interface_ipv6
  public_key     = local.wireguard_peers[each.key].public_key
}

# Endpoint: var.ddns.host_name, whose A (FTTH IPv4) and AAAA (FTTH IPv6) records
# were set once by hand at Cloudflare; both addresses are fixed, so there is no
# dynamic DNS. ip_version = "v4" is only the UI's choice of WAN address (and its
# automatic IPv4 firewall opening): the interface listens on both families with
# ip = "any", and unifi_firewall_rule.allow_wireguard_ports opens UDP 51820 on
# WANv6_LOCAL, which keeps the server reachable over the AAAA record.

output "wireguard_server_public_key" {
  description = "Public key of the WireGuard server, read by unifi:wg-profile."
  value       = unifi_vpn_server.wireguard.wireguard.public_key
}
