{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [],
  "dependencyDashboardApproval": false,
  "semanticCommitType": "feat",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "ignorePaths": [
    "fluxcd/homelab/flux-system/gotk-components.yaml"
  ],
  "flux": {
    "managerFilePatterns": ["/^(apps|infrastructure)/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(apps|infrastructure)/.+\\.ya?ml$/"]
  },
  "customDatasources": {
    "grafana-dashboards": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/dashboards/{{packageName}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $string(revision)}]}"
      ]
    }
  },
  "customManagers": [
    {
      "description": "grafana.com dashboards pinned by revision in the VM stack values",
      "customType": "regex",
      "managerFilePatterns": ["/^infrastructure/base/monitoring/release\\.yaml$/"],
      "matchStrings": [
        "grafana\\.com/api/dashboards/(?<packageName>\\d+)/revisions/(?<currentValue>\\d+)/download",
        "gnetId: (?<packageName>\\d+)\\s+revision: (?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "custom.grafana-dashboards",
      "depNameTemplate": "grafana-dashboard-{{{packageName}}}",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    },
    {
      "description": "litestream dashboard pinned by tag, kept in step with the litestream image",
      "customType": "regex",
      "managerFilePatterns": ["/^infrastructure/base/monitoring/release\\.yaml$/"],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/benbjohnson/litestream/(?<currentValue>v[^/]+)/grafana/"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "benbjohnson/litestream",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/base/gateway-api/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetes-sigs/gateway-api/releases/download/(?<currentValue>v[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/gateway-api"
    },
    {
      "description": "Talos extraManifests pinned by release download URL",
      "customType": "regex",
      "managerFilePatterns": ["/^talos/all/.+\\.ya?ml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[^/]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Talos extraManifests pinned by raw.githubusercontent.com tag",
      "customType": "regex",
      "managerFilePatterns": ["/^talos/all/.+\\.ya?ml$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>v[0-9][^/]*)/"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "config:recommended pulls in :semanticPrefixFixDepsChoreOthers, whose rules override the top-level semanticCommitType; .conform.yaml permits only feat and chore, so the fix(deps) prefix would be rejected",
      "matchPackageNames": ["*"],
      "semanticCommitType": "feat"
    },
    {
      "description": "automerge patch and digest only",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "automerged patches wait 3 days, so a broken or compromised upstream release does not reach the cluster minutes after publication; digests are left out because most carry no release timestamp, and timestamp-optional keeps patches without one from being held forever",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "cluster-critical charts always get reviewed, even for patches",
      "matchDatasources": ["helm"],
      "matchPackageNames": [
        "cilium",
        "longhorn",
        "cert-manager",
        "victoria-metrics-k8s-stack",
        "cloudnative-pg",
        "plugin-barman-cloud"
      ],
      "automerge": false
    },
    {
      "description": "the Postgres image carries Postgres and VectorChord; major and extension bumps need a manual check against Immich's supported range and a vchord ALTER EXTENSION UPDATE",
      "matchPackageNames": ["ghcr.io/tensorchord/cloudnative-vectorchord"],
      "automerge": false
    },
    {
      "description": "the litestream dashboard tag moves together with the litestream sidecar image",
      "matchPackageNames": ["benbjohnson/litestream", "litestream/litestream"],
      "groupName": "litestream"
    },
    {
      "description": "dashboards change visibly, always review",
      "matchDatasources": ["custom.grafana-dashboards"],
      "automerge": false
    },
    {
      "description": "paperless-ngx 3.x posts to /tika/form, which tika 4 removed",
      "matchPackageNames": ["apache/tika"],
      "allowedVersions": "<4"
    },
    {
      "description": "krr 1.30+ macOS binaries crash on start (PyInstaller pkg_resources bug); the in-cluster image is bumped separately",
      "matchManagers": ["mise"],
      "matchPackageNames": ["robusta-dev/krr"],
      "enabled": false
    },
    {
      "description": "talosctl and kubectl have to stay in step with the cluster version",
      "matchManagers": ["mise"],
      "matchPackageNames": ["talosctl", "kubectl"],
      "automerge": false
    }
  ]
}
