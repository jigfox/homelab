#!/usr/bin/env bash

BACKUP_FILE="replica_backup.txt"

# Check if the backup file exists
if [[ ! -f "$BACKUP_FILE" ]]; then
  echo "Error: Backup file '$BACKUP_FILE' not found!"
  exit 1
fi

echo "Restoring replica counts from $BACKUP_FILE..."

# Read the backup file line by line
while read -r namespace kind name replicas; do

  # Skip empty lines
  if [[ -z "$namespace" ]]; then
    continue
  fi

  echo "Restoring $kind/$name in namespace: $namespace to $replicas replicas..."
  kubectl scale "$kind/$name" --replicas="$replicas" -n "$namespace"

done <"$BACKUP_FILE"

echo "Restore complete!"
