#!/usr/bin/env bash
BACKUP_FILE="replica_backup.txt"
# Namespaces to exclude from scale-down to prevent breaking the cluster
EXCLUDE_NS="kube-system|kube-public|kube-node-lease"

echo "Starting backup of replica counts to $BACKUP_FILE..."

# Clear or create the backup file
>"$BACKUP_FILE"

# Get all Deployments and StatefulSets across all namespaces
kubectl get deploy,sts -A -o custom-columns=NAMESPACE:.metadata.namespace,KIND:.kind,NAME:.metadata.name,REPLICAS:.spec.replicas --no-headers | while read -r namespace kind name replicas; do

  # Skip excluded system namespaces
  if [[ "$namespace" =~ ^($EXCLUDE_NS)$ ]]; then
    continue
  fi

  # Only backup and scale if current replicas are a valid number greater than 0
  if [[ "$replicas" != "<none>" ]] && [[ "$replicas" -gt 0 ]] 2>/dev/null; then
    # Save to backup file
    echo "$namespace $kind $name $replicas" >>"$BACKUP_FILE"

    # Scale down the resource
    echo "Scaling down $kind/$name in namespace: $namespace..."
    kubectl scale "$kind/$name" --replicas=0 -n "$namespace"
  fi
done

echo "Backup and scale-down complete! Backup saved to $BACKUP_FILE"
